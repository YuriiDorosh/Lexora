# ============================================================
# Lexora — production environment template (M38)
# ============================================================
# Copy this file to .env.prod on the production host:
#
#   cp .env.prod.example .env.prod
#   vi .env.prod      # replace every CHANGE_ME_... with a real value
#   make prod-env-check    # refuses to start if any CHANGE_ME_ remains
#
# .env.prod is gitignored (matches .gitignore patterns
# `.env.*` and `*.env.prod`).  Never commit it.
#
# Generate strong random secrets with:
#   openssl rand -base64 32 | tr -d '/='
# (the trailing tr strips the only character the entrypoint sed
# substitution rejects: `|`.)
# ============================================================

# ── Production domain ───────────────────────────────────────
# The production domain (lexora.avantgarde.systems) is HARDCODED
# inside docker_compose/nginx/nginx.prod.conf, so it does NOT need
# to be in this file.  Let's Encrypt certs are expected on the host
# at /etc/letsencrypt/live/lexora.avantgarde.systems/.

# ============================================================
# PostgreSQL
# ============================================================
# POSTGRES_USER stays `odoo` (matches Odoo's db_user in
# odoo.prod.conf.template).  Change the password to a strong
# random value.  POSTGRES_DB seeds the initial DB; Odoo creates
# its own DB via /web/database/manager, so this is mainly the
# initdb default.
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# ============================================================
# Odoo secrets (substituted into odoo.prod.conf at container start)
# ============================================================
# ADMIN_PASSWD is the /web/database/manager master password.
# DB_PASSWORD must equal POSTGRES_PASSWORD above (Odoo reads it
# to connect to Postgres).
ADMIN_PASSWD=CHANGE_ME_odoo_master_password
DB_PASSWORD=CHANGE_ME_postgres_password

# ============================================================
# RabbitMQ — non-default credentials (NOT guest/guest)
# ============================================================
RABBITMQ_USER=CHANGE_ME_rabbitmq_user
RABBITMQ_PASS=CHANGE_ME_rabbitmq_password
RABBITMQ_VHOST=/
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ============================================================
# Redis — production must have a password (requirepass)
# ============================================================
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================
# LLM enrichment service (M4b/M4c) — prod-sensible defaults
# Same model defaults as dev; switch to 3B on >=16 GiB hosts.
# ============================================================
LLM_MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
LLM_MODEL_FILENAME=qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_MODEL_DIR=/models
LLM_N_CTX=2048
LLM_N_THREADS=0
LLM_MAX_TOKENS=512
LLM_AUTO_DOWNLOAD=1

# ============================================================
# Translation service (M4c)
# ============================================================
TRANSLATE_PROVIDER=google
TRANSLATE_FALLBACK_PROVIDER=mymemory
TRANSLATE_TIMEOUT_SECONDS=10

# ============================================================
# Audio service (M6)
# ============================================================
TTS_ENGINE=edge-tts
TTS_FALLBACK_ENGINE=espeak-ng
WHISPER_MODEL=base
AUDIO_TRANSCRIPTION_ENABLED=1
AUDIO_MAX_DURATION_SECONDS=300
AUDIO_SYNC_MAX_SECONDS=90
AUDIO_SYNC_MAX_BYTES=15728640
