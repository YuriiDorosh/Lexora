<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="rule_language_lesson_owner" model="ir.rule">
            <field name="name">Language Lesson: owner only</field>
            <field name="model_id" ref="model_language_lesson"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('language_security.group_language_user'))]"/>
        </record>

        <record id="rule_language_lesson_item_owner" model="ir.rule">
            <field name="name">Language Lesson Item: owner only</field>
            <field name="model_id" ref="model_language_lesson_item"/>
            <field name="domain_force">[('lesson_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('language_security.group_language_user'))]"/>
        </record>

    </data>
</odoo>
