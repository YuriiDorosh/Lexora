<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron: consume lesson.extraction result events from RabbitMQ.
             Runs every minute. Drains lesson.extraction.completed and
             lesson.extraction.failed queues and updates language.lesson
             records that are in state='extracting' (ADR-038 § 38i).
             noupdate="1" so admins can tune the interval without it
             being reset on upgrade — same pattern as translation/anki. -->
        <record id="cron_consume_lesson_extraction_results" model="ir.cron">
            <field name="name">Lexora: Consume Lesson Extraction Results</field>
            <field name="model_id" ref="language_lessons.model_language_lesson"/>
            <field name="state">code</field>
            <field name="code">model.action_consume_extraction_results()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
